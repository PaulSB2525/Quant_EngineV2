# =============================================================================
# .env.example — Quant Engine v2 (Multi-Asset: Crypto + Equity)
# INSTRUCCIONES:
#   cp .env.example .env
#   nano .env          # completar con tus credenciales reales
#   chmod 600 .env     # nunca exponer este archivo
#
# NUNCA commitear el .env real al repositorio.
# Agregar .env a .gitignore antes de cualquier git add.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# TRADING MODE
# CRÍTICO: mantener PAPER_TRADING=true hasta tener 14+ días de track record
# positivo en paper. El cambio a false compromete capital real.
#
# NOTA: este flag también fija el perfil de costos TCA crypto que el
# RiskManager inicializa AL ARRANQUE: paper -> umbral 3 bps (baja fricción de
# testnet), producción -> umbral 18 bps (costos reales de Binance spot).
# El perfil se elige una sola vez al construir el RiskManager, así que cambiar
# este flag en caliente NO surte efecto: requiere un reinicio completo del
# contenedor ('docker compose restart bot') para reinicializar el perfil.
# ──────────────────────────────────────────────────────────────────────────────
PAPER_TRADING=true   # true: TCA 3 bps (sim) | false: TCA 18 bps (prod). Cambiar => 'docker compose restart bot'

# ──────────────────────────────────────────────────────────────────────────────
# BROKER: BINANCE (Crypto leg — ccxt.pro websockets)
#
# INSTRUCCIONES DE SEGURIDAD:
#   1. Crear SUBCUENTA dedicada (nunca usar cuenta principal)
#   2. API Management → Create API → activar SÓLO: Read + Spot Trading
#   3. NUNCA activar Withdrawals, Margin, Futures en esta key
#   4. Whitelist IP estática del Node A (obligatorio para producción)
#   5. Si no tienes IP estática: usar DDNS + ufw on Node A
# ──────────────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# BROKER: ALPACA (Equity leg — alpaca-py SDK)
#
# INSTRUCCIONES:
#   1. Cuenta paper: https://app.alpaca.markets (gratis, sandbox completo)
#   2. Cuenta live: requiere aprobación (US o IBKR-bridge para internacional)
#   3. API Keys: API Management → Generate New Key
#   4. Permisos necesarios: Trading (Market + Limit orders) + Market Data
#   5. Paper URL automática según PAPER_TRADING=true en BotConfig
# ──────────────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# ACTIVOS — Formato: PREFIX:NATIVE_SYMBOL (coma-separados)
#
# Prefijos válidos:
#   CRYPTO:  → enrutado a BinanceBrokerAdapter
#   EQUITY:  → enrutado a AlpacaBrokerAdapter + MarketSessionGuard
#
# Compatibilidad v1: strings sin prefijo (BTC/USDT) → CRYPTO por defecto.
#
# Ejemplos:
#   Solo crypto:   CRYPTO:BTC/USDT,CRYPTO:ETH/USDT,CRYPTO:SOL/USDT
#   Solo equity:   EQUITY:AAPL,EQUITY:NVDA,EQUITY:SMH
#   Multi-asset:   CRYPTO:BTC/USDT,CRYPTO:ETH/USDT,EQUITY:AAPL,EQUITY:NVDA
# ──────────────────────────────────────────────────────────────────────────────
SYMBOLS=CRYPTO:BTC/USDT,CRYPTO:ETH/USDT

# ──────────────────────────────────────────────────────────────────────────────
# PARES COINTEGRADOS — Formato: "ASSET_A|ASSET_B" (coma-separados)
#
# Convención: A = asset con alpha esperado (menos líquido)
#             B = hedger (más líquido, usado como benchmark)
#
# Ejemplos:
#   Crypto/Crypto:  CRYPTO:ETH/USDT|CRYPTO:BTC/USDT
#   Equity/Equity:  EQUITY:NVDA|EQUITY:SMH
#   Cross-asset:    EQUITY:COIN|CRYPTO:BTC/USDT   (experimental: horas mismatch)
#
# Dejar vacío para desactivar pair trading (solo single-asset):
PAIR_SYMBOLS=

# ──────────────────────────────────────────────────────────────────────────────
# HORARIOS DE MERCADO (equity)
# Pre/post-market: spreads más amplios, menor liquidez, mayor slippage.
# Recomendado: false en ambos para estrategias de mean-reversion.
# El MarketSessionGuard congela buffers OU/GARCH durante el cierre.
# ──────────────────────────────────────────────────────────────────────────────
ALLOW_PRE_MARKET=false
ALLOW_POST_MARKET=false

# ──────────────────────────────────────────────────────────────────────────────
# BASES DE DATOS
# Los DSNs internos de docker-compose (que apuntan a los nombres de servicio)
# se sobreescriben en el compose. Aquí configura para acceso externo/local.
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=quant
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=quant

# ──────────────────────────────────────────────────────────────────────────────
# LLMs
#
# GEMINI_API_KEY  : https://aistudio.google.com → Get API key
#                   Uso: análisis de sentimiento de noticias (~15 req/min free)
# DEEPSEEK_API_KEY: https://platform.deepseek.com → API Keys
#                   Uso: validación de tesis crypto/equity/pair (chain-of-thought)
#
# Desactivar LLM validation completamente (bot opera 100% math-driven):
#   ENABLE_LLM_VALIDATION=false
# ──────────────────────────────────────────────────────────────────────────────
ENABLE_LLM_VALIDATION=true
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM — Alertas de ejecución y reporte PnL diario
#
# Obtener TELEGRAM_BOT_TOKEN:
#   1. Hablar con @BotFather en Telegram
#   2. /newbot → seguir instrucciones → copiar token
#   3. Enviar /start al bot (sin esto, no puede iniciarte mensajes)
#
# Obtener TELEGRAM_CHAT_ID:
#   1. Hablar con @userinfobot → copia el "Id:" numérico
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────────────────────────────────────
# DASHBOARD — Autenticación Streamlit
#
# ADMIN_PASSWORD_HASH: hash bcrypt del password del panel.
# Generar con:
#   python3 -c "import streamlit_authenticator as sa; print(sa.Hasher.hash('TuPassword'))"
#
# AUTH_COOKIE_KEY: clave para firmar la cookie de sesión. Mínimo 32 chars.
# Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# AUTH_CONFIG_PATH: ruta al YAML completo de usuarios (opcional).
# Si no se monta el YAML, se usa ADMIN_PASSWORD_HASH para el usuario 'admin'.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD_HASH=
AUTH_COOKIE_KEY=cambia_esto_por_32_caracteres_random_generado_con_secrets
AUTH_CONFIG_PATH=/etc/quant/auth.yaml
